# Copy to the plugin config dir:
#   cp config.env.example "$(herdr plugin config-dir blockedpath.jev-names)/config.env"
# Environment variables with the same names take precedence over this file.

# Required. Get a key at https://typesafe.ai
TYPESAFE_API_KEY=

# Jev endpoint and model. Any System One endpoint works, e.g. OpenRouter
# (https://openrouter.ai/api/v1 with model ~typesafe/jev-latest).
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest

# Log what would change without renaming anything (see decisions.jsonl in the state dir).
# JEV_NAMES_DRY_RUN=0

# Turn pane or tab naming off.
# JEV_NAMES_PANES=1
# JEV_NAMES_TABS=1

# What is sent to Jev besides titles, commands, folders and branches.
# Recent terminal output (last 40 lines) and the agent's first and latest
# request. Both are redacted for common secret formats first.
# JEV_NAMES_SEND_OUTPUT=1
# JEV_NAMES_SEND_PROMPTS=1

# Labels written by other tools that may be replaced, separated by |.
# JEV_NAMES_PLACEHOLDERS=new orb

# Name length limits, in characters.
# JEV_NAMES_MAX_PANE_LENGTH=32
# JEV_NAMES_MAX_TAB_LENGTH=24

# Jev must give its pick at least this probability before a name is applied.
# JEV_NAMES_MIN_PROBABILITY=0.3
# A new pick must beat the current one by this much, so names don't flicker.
# JEV_NAMES_HYSTERESIS=0.15

# Between an activity and its subject, e.g. "server · web".
# JEV_NAMES_SEPARATOR=" · "
